.claude/settings.local.json

# node.js
node_modules/
npm-debug.log

# bun only; no npm or yarn lockfiles
/package-lock.json
/yarn.lock

# Xcode
**/.xcode.env.local
build/
*.pbxuser
!default.pbxuser
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
project.xcworkspace

# CocoaPods
apps/example/ios/Pods

# Expo prebuild output of the showcase; regenerated from app.json
apps/showcase/ios/
apps/showcase/android/

# Ruby
apps/example/vendor/

# Android
.kotlin
.classpath
.cxx
.gradle
.project
.settings
local.properties
*.iml

# TypeScript build output (package root only; not `third_party/h3/lib`, which holds vendored C sources)
/packages/*/lib/
*.tsbuildinfo

# caches
.cache
compile_commands.json
coverage

# npm pack rehearsals
*.tgz

# React Native Harness
apps/example/.harness/

# Promo video project: its own install, the raw takes, the clips cut from them and the renders
tools/promo/node_modules/
tools/promo/takes/
tools/promo/public/clips/
tools/promo/out/

# Local planning record (design decisions, plans and research)
# Kept outside the repo; upstream React Native packages use `docs/` for the user manual, not a design archive.
docs/superpowers/
.superpowers/
docs/research/
Pods/
*.xcworkspace
!apps/example/ios/*.xcworkspace

# Claude Code skills, worktrees and local settings stay on this machine
.claude/
