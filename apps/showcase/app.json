{
  "expo": {
    "name": "H3 Showcase",
    "slug": "h3-showcase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.h3showcase",
      "supportsTablet": true
    },
    "android": {
      "package": "com.h3showcase",
      "adaptiveIcon": {
        "backgroundColor": "#060911",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Trail act draws the route you walk as H3 cells while it is on screen."
        }
      ]
    ]
  }
}
