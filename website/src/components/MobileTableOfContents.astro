---
import { tocEntries } from './toc'

const { toc } = Astro.locals.starlightRoute

const entries = toc ? tocEntries(toc.items, toc.minHeadingLevel) : []

// The first entry is Starlight's own link back to the title, so a page whose headings are only
// that one has nothing to navigate and gets no bar.
const hasHeadings = entries.length > 1
---

{
  hasHeadings && (
    <div class="nh3-toc">
      <div class="nh3-toc-inner">
        <button
          class="nh3-toc-button"
          type="button"
          aria-expanded="false"
          aria-controls="nh3-toc-panel"
        >
          <svg class="nh3-toc-ring" viewBox="0 0 20 20" aria-hidden="true">
            <circle class="nh3-toc-ring-track" cx="10" cy="10" r="8" />
            <circle class="nh3-toc-ring-value" cx="10" cy="10" r="8" pathLength="1" />
          </svg>
          <span class="nh3-toc-label">{entries[0]?.text}</span>
          <svg
            class="nh3-toc-chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>
      </div>

      <nav id="nh3-toc-panel" class="nh3-toc-panel" aria-label="On this page" hidden>
        <ul class="nh3-toc-list">
          {entries.map((entry) => (
            <li class="nh3-toc-item" style={`--nh3-toc-level: ${entry.level}`}>
              <a href={`#${entry.slug}`}>{entry.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<script>
  import { trackToc } from './toc'

  const OPEN_LABEL = 'On this page'
  const FADE_MS = 150

  const root = document.querySelector<HTMLElement>('.nh3-toc')
  const button = root?.querySelector<HTMLButtonElement>('.nh3-toc-button')
  const label = root?.querySelector<HTMLElement>('.nh3-toc-label')
  const panel = document.getElementById('nh3-toc-panel')
  const article = document.querySelector<HTMLElement>('.sl-markdown-content')

  if (root && button && label && panel && article) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)')
    let currentLink: HTMLAnchorElement | undefined
    let hideTimer = 0

    const isOpen = () => button.getAttribute('aria-expanded') === 'true'

    // The collapsed bar names the entry being read, the open one names the panel.
    const toc = trackToc({
      root,
      list: panel,
      article,
      onDraw: (current) => {
        currentLink = current
        label.textContent = isOpen() ? OPEN_LABEL : (current?.textContent ?? '')
      },
    })

    const setOpen = (open: boolean) => {
      clearTimeout(hideTimer)
      button.setAttribute('aria-expanded', String(open))
      toc.redraw()
      if (open) {
        panel.hidden = false
        const item = currentLink?.parentElement
        if (item) panel.scrollTop = item.offsetTop - panel.clientHeight / 2
        // Settle the layout at opacity 0 first, so the fade in runs from there.
        void panel.offsetHeight
        panel.classList.add('open')
        return
      }
      panel.classList.remove('open')
      hideTimer = window.setTimeout(
        () => {
          panel.hidden = true
        },
        reduced.matches ? 0 : FADE_MS
      )
    }

    button.addEventListener('click', () => setOpen(!isOpen()))

    panel.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false)
    })

    document.addEventListener('click', (event) => {
      if (isOpen() && !root.contains(event.target as Node)) setOpen(false)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !isOpen()) return
      setOpen(false)
      button.focus()
    })

    // The wide layout hides the bar for Starlight's own column, so an open state must not survive
    // the breakpoint and come back on the way down. Same boundary as `71.9375rem` in
    // `src/styles/custom.css`, from the other side.
    matchMedia('(min-width: 72rem)').addEventListener('change', () => setOpen(false))
  }
</script>
