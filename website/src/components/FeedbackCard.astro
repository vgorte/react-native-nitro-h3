---
import { REPO } from '../../pages'
---

<aside class="nh3-feedback">
  <p class="nh3-feedback-heading">Shipping with this?</p>
  <p class="nh3-feedback-body">
    Star the repository. It is the only feedback an open-source package gets by default.
  </p>
  <a class="nh3-feedback-button" href={REPO}>Star on GitHub</a>
  <a class="nh3-feedback-link" href={`${REPO}/issues/new`}>Something look wrong?</a>
</aside>

<style>
  .nh3-feedback {
    margin-top: 1.5rem;
    padding: 0.875rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }

  .nh3-feedback-heading {
    margin: 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .nh3-feedback-body {
    margin: 0.35rem 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }

  .nh3-feedback-button {
    display: block;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.375rem;
    background: var(--sl-color-accent-low);
    color: var(--nh3-accent-light);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
  }

  .nh3-feedback-button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  /* One weight below the button: no fill, no border, and the underline carries the affordance. */
  .nh3-feedback-link {
    display: block;
    margin-top: 0.625rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nh3-feedback-link:hover {
    color: var(--sl-color-white);
  }

  .nh3-feedback a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>
