{
  "name": "react-native-nitro-h3",
  "version": "0.4.0",
  "description": "Native H3 geospatial indexing for React Native, up to 862x faster than h3-js. Uber's H3 C library exposed through Nitro Modules, with bigint cell indexes, typed-array results and batch operations.",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "license": "MIT",
  "author": "Viktor Gorte",
  "homepage": "https://vgorte.github.io/react-native-nitro-h3/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vgorte/react-native-nitro-h3.git"
  },
  "bugs": {
    "url": "https://github.com/vgorte/react-native-nitro-h3/issues"
  },
  "keywords": [
    "react-native",
    "react-native-h3",
    "react-native-nitro-h3",
    "nitro-modules",
    "nitro",
    "h3",
    "uber-h3",
    "geospatial",
    "spatial-index",
    "hexagon",
    "hexagonal-grid",
    "hex-grid",
    "maps",
    "expo",
    "jsi",
    "ios",
    "android",
    "typescript",
    "high-performance"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "build": "rm -rf lib tsconfig.tsbuildinfo && tsc",
    "specs": "nitrogen",
    "test": "bun test",
    "parity": "bun test parity",
    "prepack": "bun run ../../scripts/check-pack.ts",
    "release": "release-it"
  },
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "cpp/*.hpp",
    "cpp/*.cpp",
    "cpp/core",
    "cpp/ops",
    "cpp/shapes",
    "third_party/h3/include/**/*.h",
    "third_party/h3/lib/**/*.c",
    "third_party/h3/LICENSE",
    "third_party/h3/NOTICE",
    "third_party/h3/H3_VERSION",
    "third_party/h3/sources.json",
    "android/build.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "docs/api.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "npm": {
      "publish": true,
      "skipChecks": true,
      "publishArgs": [
        "--provenance"
      ]
    },
    "git": false,
    "github": {
      "release": false
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "h3-js": "4.5.0",
    "nitrogen": "0.37.1",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-nitro-modules": "0.37.1",
    "typescript": "^6.0.3"
  }
}
